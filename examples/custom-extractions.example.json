[
  {
    "name": "Product SKU",
    "css": "[data-product-sku], .sku",
    "extract": "text",
    "adaptive": true
  },
  {
    "name": "Product Price",
    "json_ld_type": "Product",
    "json_ld_field": "offers.price",
    "fallback_regex": "\"price_sale\"\\s*:\\s*\\{[^}]*\"dollars\"\\s*:\\s*([\\d.]+)",
    "adaptive": true
  },
  {
    "name": "Phone",
    "regex": "tel:([+\\d\\s-]+)"
  }
]
